# Copy this file to .env (for local dev with `vercel dev`) and fill in real
# values. Never commit .env — it's gitignored. In production these are set
# as Environment Variables in the Vercel project dashboard.

# Resend (https://resend.com) — sends the waitlist confirmation email and
# adds the signup to the matching Audience.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Alex Bento <no-reply@alexffb.com>

# Resend Audience IDs — one per waitlist, so /comunidade and /merch signups
# are tracked as separate lists. https://resend.com/audiences
RESEND_AUDIENCE_ID_COMUNIDADE=
RESEND_AUDIENCE_ID_MERCH=

# Supabase (https://supabase.com) — logs every waitlist signup into a
# waitlist_submissions table as a backup registry alongside Resend. The
# publishable/anon key is safe to expose: the table's RLS policy only
# allows INSERT, never SELECT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
