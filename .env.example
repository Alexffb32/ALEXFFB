# Copy this file to .env.local and fill in real values. Never commit .env or .env.local.

# Public site URL (used for canonical links, sitemap, JSON-LD, hreflang)
NEXT_PUBLIC_SITE_URL=https://alexffb.com

# Resend (https://resend.com) — used to send the waitlist confirmation email
# and to add subscribers to the right audience/list.
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=

# Resend Audience IDs — create two separate audiences in Resend (or your ESP
# of choice) so /comunidade and /merch signups are tracked as separate lists.
# https://resend.com/audiences
RESEND_AUDIENCE_ID_COMUNIDADE=
RESEND_AUDIENCE_ID_MERCH=

# Email address the waitlist confirmation is sent "from". Must be a verified
# sender/domain in Resend.
RESEND_FROM_EMAIL="Alex Bento <hello@alexffb.com>"

# Where contact-form messages are forwarded to. Defaults to contact@alexffb.com.
CONTACT_EMAIL_TO=contact@alexffb.com
