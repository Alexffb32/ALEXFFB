# Copy this file to .env (for local dev with `vercel dev`) and fill in real
# values. Never commit .env — it's gitignored. In production these are set
# as Environment Variables in the Vercel project dashboard.

# Resend (https://resend.com) — sends the waitlist confirmation email and
# adds the signup to the matching Audience, and emails the contact form.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Alexandre Bento <no-reply@alexffb.com>

# Resend Audience ID for the single general waitlist at /newsletter.
# https://resend.com/audiences
RESEND_AUDIENCE_ID_NEWSLETTER=

# Where the contact form's messages are emailed to (Alexandre's inbox).
CONTACT_NOTIFY_EMAIL=

# Supabase (https://supabase.com) — logs every waitlist/contact submission
# into a table as a backup registry alongside Resend. The publishable/anon
# key is safe to expose: RLS only allows INSERT, never SELECT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
